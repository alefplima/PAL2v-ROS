  <version>1.1.0</version>
  <description>Experiment E5 (PX4 SITL x500 in Gazebo): altitude by PAL2v fusion of baro + LiDAR + GPS under faults</description>
  <maintainer email="alessandro.lima@unisanta.br">Alessandro Ferreira Paz Lima</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>lpa2v</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>lpa2v_msgs</exec_depend>
  <exec_depend>lpa2v_ros</exec_depend>
  <exec_depend>lpa2v_sim</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
