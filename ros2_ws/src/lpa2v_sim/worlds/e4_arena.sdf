<?xml version="1.0" ?>
<!-- E4: 5 x 5 m arena with fixed obstacles for the TurtleBot3 reactive avoidance (LPA2v).
     Same layout in all runs; the variation between runs comes only from the noise/fault seed. -->
<sdf version="1.8">
  <world name="e4_arena">
    <physics name="fast" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <specular>0.2 0.2 0.2 1</specular>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.85 0.9 0.95 1</background></scene>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- walls (5 x 5 m, 0.5 m high) -->
    <model name="walls">
      <static>true</static>
      <link name="n"><pose>0 2.55 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>5.2 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5.2 0.1 0.5</size></box></geometry><material><ambient>0.35 0.40 0.50 1</ambient><diffuse>0.45 0.50 0.62 1</diffuse></material></visual></link>
      <link name="s"><pose>0 -2.55 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>5.2 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5.2 0.1 0.5</size></box></geometry><material><ambient>0.35 0.40 0.50 1</ambient><diffuse>0.45 0.50 0.62 1</diffuse></material></visual></link>
      <link name="e"><pose>2.55 0 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 5.0 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 5.0 0.5</size></box></geometry><material><ambient>0.35 0.40 0.50 1</ambient><diffuse>0.45 0.50 0.62 1</diffuse></material></visual></link>
      <link name="w"><pose>-2.55 0 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 5.0 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 5.0 0.5</size></box></geometry><material><ambient>0.35 0.40 0.50 1</ambient><diffuse>0.45 0.50 0.62 1</diffuse></material></visual></link>
    </model>

    <!-- obstacles -->
    <model name="obstacles">
      <static>true</static>
      <link name="c1"><pose>1.2 0.6 0.25 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.20</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.20</radius><length>0.5</length></cylinder></geometry><material><ambient>0.80 0.45 0.10 1</ambient><diffuse>0.95 0.55 0.15 1</diffuse></material></visual></link>
      <link name="c2"><pose>-1.0 1.3 0.25 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry><material><ambient>0.80 0.45 0.10 1</ambient><diffuse>0.95 0.55 0.15 1</diffuse></material></visual></link>
      <link name="c3"><pose>-1.3 -1.1 0.25 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry><material><ambient>0.80 0.45 0.10 1</ambient><diffuse>0.95 0.55 0.15 1</diffuse></material></visual></link>
      <link name="b1"><pose>0.6 -1.4 0.25 0 0 0.5</pose>
        <collision name="c"><geometry><box><size>0.6 0.3 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.3 0.5</size></box></geometry><material><ambient>0.80 0.45 0.10 1</ambient><diffuse>0.95 0.55 0.15 1</diffuse></material></visual></link>
      <link name="b2"><pose>0.2 1.6 0.25 0 0 -0.3</pose>
        <collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry><material><ambient>0.80 0.45 0.10 1</ambient><diffuse>0.95 0.55 0.15 1</diffuse></material></visual></link>
      <link name="b3"><pose>1.8 -0.6 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.3 0.8 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 0.8 0.5</size></box></geometry><material><ambient>0.80 0.45 0.10 1</ambient><diffuse>0.95 0.55 0.15 1</diffuse></material></visual></link>
    </model>

    <include>
      <uri>model://turtlebot3_lpa</uri>
      <name>tb3</name>
      <pose>-1.8 0 0.01 0 0 0</pose>
    </include>
  </world>
</sdf>
