<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lpa2v_sim</name>
  <version>1.0.0</version>
  <description>Experiment E4 (TurtleBot3 in Gazebo): reactive obstacle avoidance with PAL2v fusion of sonar + LiDAR + IR under faults</description>
  <maintainer email="alessandro.lima@unisanta.br">Alessandro Ferreira Paz Lima</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>lpa2v</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>lpa2v_msgs</exec_depend>
  <exec_depend>lpa2v_ros</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
